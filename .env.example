# Simple shared-password login gate (mirrors smokin-sixteen).
# Set this in Vercel project settings / .env.local for local dev.
APP_PASSWORD=changeme

# Optional: override NHL API base URLs if they ever move.
# NHL_API_BASE=https://api-web.nhle.com
# NHL_SEARCH_BASE=https://search.d3.nhle.com

# RotoWire feeds (injuries/news, projected goalies). Value goes in Vercel env vars.
ROTOWIRE_API_KEY=

# Yahoo Fantasy (ownership %). See PRD-fantasy-hockey.md §9
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=

# Slack delivery (bot token required to upload card images)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Protects the scheduled endpoint
CRON_SECRET=
