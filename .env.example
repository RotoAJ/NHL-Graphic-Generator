# Simple shared-password login gate (mirrors smokin-sixteen).
# Set this in Vercel project settings / .env.local for local dev.
APP_PASSWORD=changeme

# Optional: override NHL API base URLs if they ever move.
# NHL_API_BASE=https://api-web.nhle.com
# NHL_SEARCH_BASE=https://search.d3.nhle.com

# RotoWire feeds (injuries/news, projected goalies). Value goes in Vercel env vars.
ROTOWIRE_API_KEY=

# Yahoo Fantasy (ownership %). See PRD-fantasy-hockey.md §9
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=

# Slack delivery (bot token required to upload card images).
# SLACK_CHANNEL_ID accepts a channel id (C...) or your own member id (U...) for a DM.
# Scopes: chat:write, files:write, and im:write if using a DM.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Protects the scheduled endpoint
CRON_SECRET=

# --- X (Twitter) posting for the goalie matchup tool ---
# OAuth 1.0a user-context credentials for the RotoWire NHL posting account.
# Values go in Vercel env vars only; never commit them.
X_NHL_API_KEY=
X_NHL_API_SECRET=
X_NHL_ACCESS_TOKEN=
X_NHL_ACCESS_SECRET=

# Kill switch. Posting happens ONLY when this is exactly "1".
# Anything else (unset, "0", "false") makes every run a dry run, so posting can
# be stopped from the Vercel dashboard without a redeploy.
X_POSTING_ENABLED=0

# Optional guard: the handle these credentials are expected to resolve to
# (without the @). If set and the token belongs to a different account, the
# poster refuses rather than posting to the wrong place.
X_NHL_EXPECTED_HANDLE=
